{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "openAiAccountName": { "value": "${MATCHLENS_OPENAI_ACCOUNT=}" },
    "openAiResourceGroup": { "value": "${MATCHLENS_OPENAI_RESOURCE_GROUP=}" },
    "openAiEndpoint": { "value": "${MATCHLENS_OPENAI_ENDPOINT=}" },
    "modelFast": { "value": "${MATCHLENS_MODEL_FAST=gpt-5-mini}" },
    "modelStrong": { "value": "${MATCHLENS_MODEL_STRONG=gpt-5-mini}" },
    "backendImageName": { "value": "${SERVICE_BACKEND_IMAGE_NAME=}" },
    "frontendImageName": { "value": "${SERVICE_FRONTEND_IMAGE_NAME=}" }
  }
}
