{
  "name": "demo-video",
  "version": "1.0.0",
  "description": "Matchlens replacement hackathon film with dedicated Coach and tactical simulation demo",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --port 3200",
    "assets": "node scripts/prepare-assets.mjs && python3 scripts/prepare-v2.py",
    "capture": "node scripts/record-product.mjs",
    "check": "node scripts/verify-v2.mjs",
    "render:preview": "remotion render src/index.ts Matchlens-Submission out/matchlens-new-cut.mp4 --codec=h264 --crf=18 --props=delivery-props.local.json",
    "render:final": "node scripts/verify-v2.mjs --final && remotion render src/index.ts Matchlens-Submission out/matchlens-submission.mp4 --codec=h264 --crf=16 --props=delivery-props.local.json",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "prerender:preview": "npm run assets",
    "prerender:final": "npm run assets",
    "assets:v2": "python3 scripts/prepare-v2.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
