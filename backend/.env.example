# Azure OpenAI (v1) endpoint of the Foundry resource. Auth uses Entra ID (az login / managed identity).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
# Optional for local development. Leave unset to use Azure CLI / managed identity.
AZURE_OPENAI_API_KEY=
MATCHLENS_MODEL_FAST=gpt-5-mini
MATCHLENS_MODEL_STRONG=gpt-5-mini
MATCHLENS_REASONING_FAST=low
MATCHLENS_REASONING_STRONG=high
# Google Identity Services OAuth web client ID; the same client ID is used by the frontend.
GOOGLE_CLIENT_ID=
# Required to issue app sessions. Generate a random 32+ byte secret; never expose it to the frontend.
MATCHLENS_AUTH_SECRET=
# Set to 1 behind HTTPS in production; keep 0 for localhost development.
MATCHLENS_COOKIE_SECURE=0
# auto | online | offline
MATCHLENS_LLM=auto

# Online latency tuning (defaults shown). Workflow timeout defaults to 3 x agent timeout + 5 s.
# MATCHLENS_AGENT_TIMEOUT_S=25
# MATCHLENS_WORKFLOW_TIMEOUT_S=
# MATCHLENS_AGENT_CONCURRENCY=4
# MATCHLENS_MAX_LAG_S=300

# Store (see docs/DATABASE.md). Unset: runs are kept in memory only and lost on restart.
# Local emulator: npm run db:emulator, then MATCHLENS_COSMOS_ENDPOINT=http://localhost:8081
# Azure: https://<account>.documents.azure.com:443/ with az login (Cosmos DB Built-in Data Contributor role).
# MATCHLENS_COSMOS_ENDPOINT=http://localhost:8081
# MATCHLENS_COSMOS_DATABASE=matchlens

# Recorded demo match (see docs/DEPLOY.md). Unset or "off" to always call the model.
# MATCHLENS_CASSETTE=demo/hero-match.json
# MATCHLENS_CASSETTE_DELAY=0.5
