# Azure OpenAI (v1) endpoint of the Foundry resource. Auth uses Entra ID (az login / managed identity).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
MATCHLENS_MODEL_FAST=gpt-5-mini
MATCHLENS_MODEL_STRONG=gpt-5-mini
MATCHLENS_REASONING_FAST=low
MATCHLENS_REASONING_STRONG=high
# auto | online | offline
MATCHLENS_LLM=auto

# Online latency tuning (defaults shown). Workflow timeout defaults to 3 x agent timeout + 5 s.
# MATCHLENS_AGENT_TIMEOUT_S=25
# MATCHLENS_WORKFLOW_TIMEOUT_S=
# MATCHLENS_AGENT_CONCURRENCY=4
# MATCHLENS_MAX_LAG_S=300

# Recorded demo match (see docs/DEPLOY.md). Unset or "off" to always call the model.
# MATCHLENS_CASSETTE=demo/hero-match.json
# MATCHLENS_CASSETTE_DELAY=0.5
